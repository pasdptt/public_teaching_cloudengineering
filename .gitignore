# ---------------------------------------------------------------------------
# This is a PUBLIC repository. Nothing that reveals assessment answers may be
# committed here. Instructor material lives in a separate private repository:
#   ../cloudengineering-instructor
# See planning/decisions.md (D-01) and operations/publishing-checklist.md.
# ---------------------------------------------------------------------------

# Defence in depth: if instructor material is ever created inside this tree by
# mistake, git will not stage it.
instructor/
**/solution/
**/solutions/
*-solution.*
*_solution.*
*-key.*
*answer-key*
# The private repository's own folders and files, by name, so copying one across by mistake
# leaves it unstageable. planning/leakcheck.py checks the same names and the content.
exam-papers/
quiz-keys/
lab-solutions/
pilot-evidence/
teaching-notes/
project-guidance.md
delivery-guide.md
midterm*.md
exams/final.md
# Quiz papers and the final practice set are private too (D-71)
quizzes/
quiz-[0-9]*.md
*final-practice*.md
exams/*practice*

# Credentials and cloud state — never commit
*.json.key
*-credentials.json
service-account*.json
.env
.env.*
!.env.example
gcloud-config/
application_default_credentials.json

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Except the two environment files, which ARE committed: the pipeline runs on a fresh machine
# and can only read what is in the repository. Nothing in them is secret -- the project id is
# configuration, and it is already public in deploy.yml through the deployer's email.
!infra/envs/dev.tfvars
!infra/envs/prod.tfvars
.terraform.tfstate.lock.info
crash.log
override.tf
override.tf.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Lab run artefacts (measurements are submitted, not committed)
runs/
results/
*.local.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Student lab config (holds a project id). One line per lab rather than a glob, so that
# adding a lab is a deliberate act and a stray config.env somewhere else is still visible.
weeks/week-04/lab-02/starter/config.env
weeks/week-09/lab-04/starter/config.env
weeks/week-11/lab-05/starter/config.env
weeks/week-13/lab-06/starter/config.env

# Rendered slide decks. The markdown is the authority (D-65).
course/slides/out/

# Files the Claude app saves into this folder when it delivers something. Not source.
Claude outputs/
