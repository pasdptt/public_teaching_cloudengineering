# Copy to config.env and fill in. config.env is gitignored -- it holds your project id.
# Nothing secret belongs here: every value below is configuration, and Part 4 asks you why
# the pool id and the deployer's email are safe to publish while a key would not be.

PROJECT_ID="your-project-id-here"

# Your repository on GitHub, exactly as it appears in its URL: owner/name.
# This string becomes the federation provider's attribute condition. A typo here is the
# single most common reason the pipeline's auth step fails -- read it twice.
GITHUB_REPO="your-github-user/your-repo"

# Same region as everything else in this course (a free-tier region).
REGION="us-central1"

POOL_ID="github"
PROVIDER_ID="github-actions"
DEPLOYER_SA_NAME="docapp-deployer"
