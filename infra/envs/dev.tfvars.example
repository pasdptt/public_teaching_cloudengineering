# dev environment. Copy to dev.tfvars and set project_id.
#
# The differences from prod.tfvars are the point of this file. Every one of them should be
# a choice you can defend; anything that differs by accident is a bug waiting for a bad day.

project_id = "your-project-id-here"
environment = "dev"
region      = "us-central1"

# Placeholder. The pipeline passes the real image with -var; this value only matters when
# you apply by hand.
image = "us-central1-docker.pkg.dev/your-project-id-here/docapp/docapp:latest"

# Cheaper to be wrong here, so the guard rail can be tighter.
max_instances = 1

# Faster feedback while developing.
processing_delay_ms = 50

# Noisier, because in dev you are the one reading the logs.
log_level = "debug"

# Queue settings. These differ, and Lab 6 Part 3 asks you to say whether they SHOULD.
#
# Short retention in dev: nothing here is worth keeping, and a subscription you abandon
# mid-experiment should forget about it quickly.
message_retention_seconds = 600

# A short ack deadline makes redelivery easy to trigger while you are experimenting.
ack_deadline_seconds = 10

# Give up quickly. In dev, a message that cannot be processed is usually a bug you are
# about to fix, not work you need to preserve.
max_delivery_attempts = 5
