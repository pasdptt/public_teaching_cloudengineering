# ---------------------------------------------------------------------------
# This is a PUBLIC repository. Nothing that reveals assessment answers may be
# committed here. Instructor material lives in a separate private repository:
#   ../cloudengineering-instructor
# See planning/decisions.md (D-01) and operations/publishing-checklist.md.
# ---------------------------------------------------------------------------

# Defence in depth: if instructor material is ever created inside this tree by
# mistake, git will not stage it.
instructor/
**/solution/
**/solutions/
*-solution.*
*-key.*
*answer-key*

# Credentials and cloud state — never commit
*.json.key
*-credentials.json
service-account*.json
.env
.env.*
!.env.example
gcloud-config/
application_default_credentials.json

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
infra/envs/*.tfvars
!infra/envs/*.tfvars.example
.terraform.tfstate.lock.info
crash.log
override.tf
override.tf.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Lab run artefacts (measurements are submitted, not committed)
runs/
results/
*.local.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Student lab config (holds a project id). One line per lab rather than a glob, so that
# adding a lab is a deliberate act and a stray config.env somewhere else is still visible.
labs/lab-02/starter/config.env
labs/lab-04/starter/config.env
labs/lab-05/starter/config.env
