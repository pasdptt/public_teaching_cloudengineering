# Copy to config.env and fill in. config.env is gitignored -- it holds your project id.

PROJECT_ID="your-project-id-here"
REGION="us-central1"

# Lab 5 redeploys the Lab 4 service with a queue behind it. Same names, on purpose: you
# tore it all down at the end of Lab 4 and you are about to bring it back from source,
# which is the first time this course asks you to prove a deployment is reproducible.
SERVICE_NAME="docapp"
REPO_NAME="docapp"
IMAGE_NAME="docapp"
IMAGE_TAG="v2"                     # v1 was Lab 4. A new build gets a new tag.
RUNTIME_SA_NAME="docapp-run"       # the identity the service runs as
PUSH_SA_NAME="docapp-push"         # the identity Pub/Sub uses to CALL the service
BUCKET_NAME=""                     # leave empty: 02-create-queue.sh derives it

TOPIC_NAME="docapp-jobs"
SUBSCRIPTION_NAME="docapp-jobs-push"
DEAD_LETTER_TOPIC="docapp-jobs-dead"

# --- the flags that decide whether this lab is free -----------------------------------
MIN_INSTANCES="0"                  # must stay 0, as in Lab 4
MAX_INSTANCES="4"
CONCURRENCY="80"

# How long the broker keeps a message nobody has acknowledged. Retained messages are
# billable storage -- this is Lab 5's version of Lab 2's idle IP address.
# 3600 = one hour: long enough for Part 5's stopped-consumer experiment, short enough that
# forgetting the subscription costs approximately nothing.
MESSAGE_RETENTION_SECONDS="3600"

# How long Pub/Sub waits for your service to answer before deciding the delivery failed
# and sending the message again. Part 4 asks you to make this too short on purpose.
ACK_DEADLINE_SECONDS="60"

# After this many failed delivery attempts, the message goes to the dead-letter topic
# instead of being retried forever.
MAX_DELIVERY_ATTEMPTS="5"

PROCESSING_DELAY_MS="250"
