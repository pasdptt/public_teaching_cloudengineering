# Copy to config.env and fill in. config.env is gitignored -- it holds your project id.
#
# Nothing secret belongs in this file even so. Lab 6 makes the difference between
# configuration and secrets an explicit topic; the habit starts here.

PROJECT_ID="your-project-id-here"

# Cloud Run's free allowance is not per-region, but your bucket's is (us-west1,
# us-central1, us-east1 only). Keep the service and its storage in the same place: a
# cross-region hop would be added to every latency figure you are about to record.
REGION="us-central1"

SERVICE_NAME="docapp"
REPO_NAME="docapp"                 # the Artifact Registry repository
IMAGE_NAME="docapp"
IMAGE_TAG="v1"                     # not "latest" -- see 03-build-push.sh
RUNTIME_SA_NAME="docapp-run"       # the identity the service runs as
BUCKET_NAME=""                     # leave empty: 02-create-registry.sh derives it

# --- the two flags that decide whether this lab is free -------------------------------
MIN_INSTANCES="0"                  # must stay 0. A non-zero minimum is billed all month.
MAX_INSTANCES="4"                  # the blast radius of a mistake in your load generator.

# --- the flag Part 5 asks you to change -----------------------------------------------
# Requests one instance will handle at the same time. Cloud Run's default is 80. Part 5
# asks you to predict what happens at 1, then measure it.
CONCURRENCY="80"

# Passed through to the container. Keep it identical to the value you used for your Lab 3
# measurements, or the comparison is between two different workloads.
PROCESSING_DELAY_MS="250"
