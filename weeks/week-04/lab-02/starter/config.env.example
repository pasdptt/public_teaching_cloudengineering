# Copy to config.env and fill in. config.env is gitignored -- it holds your project id.
#
# Nothing secret belongs in this file even so. A project id is not a credential, but the
# habit of "config files are not for secrets" is one worth having before Lab 6, where the
# difference starts to matter.

PROJECT_ID="your-project-id-here"

# Region and zone are NOT free choices. The Always Free e2-micro exists only in
# us-west1, us-central1 and us-east1 (course/references.md R-01). Anywhere else bills.
REGION="us-central1"
ZONE="us-central1-a"

INSTANCE_NAME="docapp-vm"
MACHINE_TYPE="e2-micro"          # the only machine type covered by the free tier
BOOT_DISK_SIZE="10GB"            # inside the 30 GB-month standard-disk allowance
SERVICE_ACCOUNT_NAME="docapp-runtime"
FIREWALL_RULE_NAME="allow-docapp-8080"
APP_PORT="8080"
